{
  "name": "wetterstation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "description": "Klimadaten-Analyse für DWD-Wetterstationen (Göttingen, Brocken, Zugspitze)",
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "predev:server": "npm run rebuild:node --silent",
    "dev:server": "WETTER_NO_SCHEDULE=1 node --watch server/index.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prestart": "npm run rebuild:node --silent",
    "start": "NODE_ENV=production node server/index.js",
    "app": "npm run rebuild:app --silent && npm run build && electron .",
    "rebuild:app": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "pack": "npm run rebuild:app && npm run build && electron-builder",
    "typecheck": "tsc -b --noEmit",
    "pretest": "npm run rebuild:node --silent",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "fetch:air": "node scripts/fetch-air.js",
    "fetch:gauges": "node scripts/fetch-gauges.js",
    "fetch:odl": "node scripts/fetch-odl.js",
    "fetch:pollen": "node scripts/fetch-pollen.js",
    "fetch:phenology": "node scripts/fetch-phenology.js",
    "fetch:germany": "node scripts/fetch-germany.js",
    "fetch:records": "node scripts/fetch-records.js",
    "fetch:nationwide": "node scripts/fetch-nationwide.js",
    "fetch:regional": "node scripts/fetch-regional.js",
    "import:stations": "node scripts/import-stations.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "de.wetterstation.app",
    "productName": "Wetterstation",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "server/**",
      "scripts/**",
      "electron/**",
      "node_modules/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "daten-vorlage",
        "filter": [
          "**/*",
          "!weather.sqlite*"
        ]
      }
    ],
    "asar": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Wetterstation-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Wetterstation-${version}-portabel.${ext}"
    }
  }
}
